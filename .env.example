# Copy to .env and adjust if needed. Used by docker-compose.yml for local dev Postgres.
POSTGRES_DB=mealplanner
POSTGRES_USER=mealplanner
POSTGRES_PASSWORD=mealplanner
# Host port Postgres is exposed on (non-default, to avoid clashing with a local Postgres install)
POSTGRES_PORT=55432

# Anthropic API key for the agent layer (PRD 9.1 step 3+). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# HMAC signing secret for auth JWTs (PRD 9.1 step 9). Must be at least 32 bytes for HS256.
# Falls back to an insecure dev-only default if unset (see application.yml) — always set this
# for anything beyond a local throwaway run.
JWT_SECRET=

# Optional: extra JVM args for the scripts/run-*.sh helpers, e.g. a machine-local
# -Djavax.net.ssl.trustStore override if your network does TLS interception (see AV/corporate
# proxy docs). Leave unset unless you hit PKIX/certificate errors calling the Anthropic API.
AGENT_JVM_ARGS=
