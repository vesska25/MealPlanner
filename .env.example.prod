# Copy to .env on the server (same directory as docker-compose.prod.yml) and fill in real
# values. Never commit the real .env — it's gitignored. Used by docker-compose.prod.yml only;
# local dev still uses docker-compose.yml + .env.example.

POSTGRES_DB=mealplanner
POSTGRES_USER=mealplanner
# Required — docker-compose.prod.yml refuses to start mealplanner-db without this set.
POSTGRES_PASSWORD=

# Points at the mealplanner-db service by its Docker network name, not localhost — the backend
# and Postgres containers only ever talk to each other over the private mealplanner-net network.
SPRING_DATASOURCE_URL=jdbc:postgresql://mealplanner-db:5432/mealplanner
SPRING_DATASOURCE_USERNAME=mealplanner
SPRING_DATASOURCE_PASSWORD=

ANTHROPIC_API_KEY=

# Must be at least 32 bytes for HS256 — generate a real one for prod, never reuse the
# application.yml dev-only fallback.
JWT_SECRET=

# nginx serves the frontend and proxies /api/ on the same origin in prod, so this mostly
# matters for any cross-origin admin tooling, not normal browser traffic.
CORS_ALLOWED_ORIGIN=https://mealplanner.mimosa-dev.de

# PRD step 12 (Telegram bot). Leave unset to keep the bot off entirely (every Telegram-facing
# component is @ConditionalOnProperty-gated on this) — set these later if/when Sergio wants it live.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
